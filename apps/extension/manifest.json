{
  "manifest_version": 3,
  "name": "Hour Tracker Companion",
  "version": "0.1.0",
  "description": "Quickly log the previous hour, plan the next one, and receive desktop reminders.",
  "permissions": ["storage", "alarms", "notifications"],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Hour Tracker",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
