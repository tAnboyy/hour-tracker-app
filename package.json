{
  "name": "hour-tracker-app",
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "npm run start --workspace @hour-tracker/expo",
    "android": "npm run android --workspace @hour-tracker/expo",
    "ios": "npm run ios --workspace @hour-tracker/expo",
    "web": "npm run web --workspace @hour-tracker/expo",
    "web:export": "npm run web:export --workspace @hour-tracker/expo",
    "test": "node --test --experimental-strip-types packages/core/test/*.test.ts packages/data/test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.packages.json && npm run typecheck --workspace @hour-tracker/expo",
    "check:extension": "npm run check --workspace @hour-tracker/extension",
    "check": "npm run typecheck && npm test && npm run check:extension && npm run web:export"
  },
  "private": true
}
